<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <properties>
        <property id="units" type="number">0</property>
    </properties>
    <settings>
        <setting propertyKey="@Properties.units" title="@Strings.UnitsTitle"
                 prompt="@Strings.UnitsPrompt">
            <settingConfig type="list">
                <listEntry value="0">@Strings.UnitsAuto</listEntry>
                <listEntry value="1">@Strings.UnitsMiles</listEntry>
                <listEntry value="2">@Strings.UnitsKilometers</listEntry>
            </settingConfig>
        </setting>
    </settings>
</resources>
